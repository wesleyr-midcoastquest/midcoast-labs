# Secrets and state never live in the repo
*.kdbx
*.tfstate
*.tfstate.*
*.pkrvars.hcl
# Notes of the secrets proxmox-setup.sh prints (they belong in the vault, not here:
# Initialize-LabRepo.ps1 commits everything in the folder that isn't ignored)
passwords
passwords.*
.terraform/
.terraform.lock.hcl.bak
packer_cache/
crash.log

# The site's own files (site.yaml, instances.yaml, deny.txt) live in site/, a
# repo of their own, never in the product (Get-LabSiteDirectory). The old
# layout's inventory/site.yaml stays tracked where it already is; a new one
# can't be added by accident.
/site/
/inventory/site.yaml

# Generated
inventory/resolved/
out/

# Editor and note-taking clutter
.obsidian/
*.base
